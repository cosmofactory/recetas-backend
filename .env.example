# Copy to .env. The server and the import CLI load .env when it exists, and
# every make target loads it too. Demo and prod set these in the VM's
# /srv/recetas/<env>/.env and compose file (INF-2, INF-5), never from here.
# Read by: server = cmd/server (internal/config), import = cmd/import,
# compose = docker-compose.yaml, make = Makefile.

# --- Server ---

# Required (server). local | demo | prod; anything else fails at startup. Also
# sent to telemetry as deployment.environment.name.
APP_ENV=local
# server. debug | info | warn | error (default info). At debug, successful
# /healthz probes appear in the access log.
# LOG_LEVEL=info
# server. Listen address (default :8080). Compose sets :8080 in the container.
HTTP_ADDR=:8080

# --- Database ---

# Required (server, import, make migrate/seed). The Postgres DSN for running
# outside Docker; this one is the compose Postgres published below. Inside
# compose, the backend's DATABASE_URL is derived from POSTGRES_* instead.
DATABASE_URL=postgres://recetas:recetas_dev@localhost:5435/recetas?sslmode=disable

# server. pgx pool size (blank = default; both win over pool_* DSN params).
# DB_MAX_CONNS: 1-100, default 10. DB_MIN_CONNS: 0-DB_MAX_CONNS, default 1.
# Ten connections cover millisecond-scale catalog reads well above the 20 rps
# target and leave most of Postgres' default max_connections (100) for the
# import CLI (which always uses the default pool) and operators. Size it to
# the VM, which demo and prod share.
# DB_MAX_CONNS=10
# DB_MIN_CONNS=1

# --- Telemetry (OpenTelemetry -> Logfire, server only) ---

# Logfire write token. Blank = telemetry off, and nothing else in this block is
# read. Never commit a real token.
# LOGFIRE_TOKEN=
# Required with a token; must be https. Traces go to <endpoint>/v1/traces and
# logs to <endpoint>/v1/logs.
# OTEL_EXPORTER_OTLP_ENDPOINT=https://logfire-eu.pydantic.dev
# service.name on every span and log record (default recetas-backend).
# OTEL_SERVICE_NAME=recetas-backend
# Read by the OpenTelemetry SDK itself (default parentbased_always_on).
# OTEL_TRACES_SAMPLER=parentbased_traceidratio
# OTEL_TRACES_SAMPLER_ARG=0.25

# --- Local compose (docker-compose.yaml) ---

# compose. The Postgres container's database and credentials; also used by
# make test-integration to build TEST_DATABASE_URL.
POSTGRES_DB=recetas
POSTGRES_USER=recetas
POSTGRES_PASSWORD=recetas_dev
# compose. Host ports: the backend on BACKEND_HOST_PORT, Postgres on
# DB_BIND_ADDRESS:DB_HOST_PORT (keep it on 127.0.0.1).
BACKEND_HOST_PORT=8080
DB_HOST_PORT=5435
DB_BIND_ADDRESS=127.0.0.1
# compose, make. The version baked into the binary (default: the git short sha,
# or dev). CI sets sha-<7>.
# VERSION=dev

# --- Tests ---

# Integration tests read TEST_DATABASE_URL (never DATABASE_URL) and skip when
# it's unset; with CI set they fail instead. `make test-integration` creates,
# migrates and uses this DB (built from POSTGRES_* and DB_HOST_PORT unless set
# here); no other target passes it on, so `make test` always skips them.
# TEST_DATABASE_URL=postgres://recetas:recetas_dev@127.0.0.1:5435/recetas_test?sslmode=disable
