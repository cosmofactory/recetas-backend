# App
APP_ENV=local
# LOG_LEVEL=info

# Telemetry (OpenTelemetry → Logfire). Off while LOGFIRE_TOKEN is blank; nothing
# else is read then. With a token, the endpoint is required and must be https.
# LOGFIRE_TOKEN=
# OTEL_EXPORTER_OTLP_ENDPOINT=https://logfire-eu.pydantic.dev
# OTEL_SERVICE_NAME=recetas-backend

# Postgres container
POSTGRES_DB=recetas
POSTGRES_USER=recetas
POSTGRES_PASSWORD=recetas_dev

# Ports
BACKEND_HOST_PORT=8080
DB_HOST_PORT=5435
DB_BIND_ADDRESS=127.0.0.1

# Only needed for running the app outside Docker (go run ./cmd/server).
# Inside docker compose, DATABASE_URL is derived from the POSTGRES_* values.
DATABASE_URL=postgres://recetas:recetas_dev@localhost:5435/recetas?sslmode=disable
HTTP_ADDR=:8080

# pgx pool size (blank = default). Max 1-100, default 10; min 0-max, default 1.
# Ten connections cover millisecond-scale catalog reads well above the 20 rps
# target and leave most of Postgres' default max_connections (100) for the
# import CLI and operators. Size it to the VM, which demo and prod share.
# DB_MAX_CONNS=10
# DB_MIN_CONNS=1

# Integration tests read TEST_DATABASE_URL (never DATABASE_URL) and skip when
# it's unset. `make test-integration` creates, migrates and uses this DB.
# TEST_DATABASE_URL=postgres://recetas:recetas_dev@127.0.0.1:5435/recetas_test?sslmode=disable
